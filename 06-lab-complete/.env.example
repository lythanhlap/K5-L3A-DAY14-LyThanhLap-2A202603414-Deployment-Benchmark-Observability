# Biến môi trường mẫu cho Production AI Agent (KHÔNG ghi secret thật vào đây)
# Sử dụng: cp .env.example .env

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Key xác thực client (header X-API-Key)
AGENT_API_KEY=your-secret-api-key-here

# Kết nối Redis cho rate limiting & cost guard
REDIS_URL=redis://localhost:6379/0

# Giới hạn tốc độ và ngân sách LLM
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
